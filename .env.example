# ===== Ứng dụng =====
PORT=3000
APP_URL=http://localhost:3000
# Đổi thành một chuỗi ngẫu nhiên dài, giữ bí mật (dùng để ký phiên đăng nhập)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-dai-va-bi-mat

# Email của CHỦ (bạn). Tài khoản này tự động là quản trị và tự động được duyệt.
ADMIN_EMAIL=email-cua-ban@gmail.com

# ===== Gửi email OTP (Gmail SMTP) =====
# Bỏ trống SMTP_USER/SMTP_PASS -> mã OTP in ra console (tiện lúc chạy thử).
# Mật khẩu ứng dụng Gmail: myaccount.google.com/apppasswords (cần bật Xác minh 2 bước).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SayCar Đặt Hộ <no-reply@saycar.vn>

# ===== Kết nối vào saycar =====
# SAYCAR_MOCK=1 : chạy giả lập (KHÔNG gọi saycar). =0 : đẩy đơn THẬT.
SAYCAR_MOCK=0
SAYCAR_BASE_URL=https://api.saycar.vn
SAYCAR_LOGIN_PATH=/private/api/admin/login
# Tài khoản saycar "dịch vụ" để app đẩy đơn (nên tạo 1 tài khoản riêng cho app):
SAYCAR_USERNAME=
SAYCAR_PASSWORD=
# Header bắt buộc của cổng API saycar (bọc trong ngoặc kép vì có ký tự #):
SAYCAR_CLIENT_SECRET="dan-gia-tri-x-udtl-client-secret-vao-day"
SAYCAR_REFERER=https://admin.saycar.vn/
SAYCAR_ORIGIN=https://admin.saycar.vn

# ===== Hoa hồng người đặt hộ (%) =====
# % của tổng khách trả, chỉ tính khi chuyến HOÀN THÀNH. Đổi số này để đổi mức hoa hồng.
COMMISSION_PERCENT=15

# ===== Thông báo đẩy (Web Push) =====
# Chu kỳ server hỏi lại trạng thái (giây)
STATUS_POLL_SECONDS=12
# Tạo cặp khoá 1 lần:  node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_SUBJECT=mailto:email-cua-ban@gmail.com
VAPID_PUBLIC=
VAPID_PRIVATE=
# LƯU Ý: Thông báo đẩy chỉ chạy trên HTTPS (hoặc localhost khi test).
